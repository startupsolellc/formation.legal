---
/**
 * PillarLayout.astro — Hub page layout for each pillar.
 * Shows pillar description, main question, and child guide cards.
 */

import BaseLayout from './BaseLayout.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

interface GuideCard {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  draft?: boolean;
}

interface Props {
  pillarLabel: string;
  pillarDescription: string;
  seoTitle?: string;
  seoDescription?: string;
  mainQuestion: string;
  href: string;
  guides: GuideCard[];
}

const { pillarLabel, pillarDescription, seoTitle, seoDescription, mainQuestion, href, guides } = Astro.props;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: pillarLabel, href },
]);
---

<BaseLayout
  title={seoTitle ?? pillarLabel}
  description={seoDescription ?? pillarDescription}
  schemas={[breadcrumbSchema]}
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <!-- Breadcrumb -->
    <nav class="mb-8 text-base text-[var(--color-muted)]" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-text-primary)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-text-primary)] font-medium">{pillarLabel}</li>
      </ol>
    </nav>

    <!-- Pillar Header -->
    <header class="mb-12 reveal">
      <p class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-muted)] mb-2">Research pillar</p>
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)] sm:text-4xl">
        {pillarLabel}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--color-text-secondary)]">
        {pillarDescription}
      </p>
      <div class="mt-6 rounded-[var(--radius-md)] border-l-[3px] border-l-[var(--color-action)] bg-[var(--color-surface-dim)] px-5 py-4 reveal">
        <p class="text-base font-medium text-[var(--color-muted)]">
          Main question this section answers:
        </p>
        <p class="mt-1 text-[var(--color-text-primary)] font-semibold">
          {mainQuestion}
        </p>
      </div>
    </header>

    <div class="mb-10 brutal-card overflow-hidden reveal">
      <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-base font-semibold text-[var(--color-text-primary)]">Check this against your route</p>
          <p class="mt-1 text-base text-[var(--color-text-secondary)]">
            Run the planner with your country, business model, payment goal, address status, and risk tolerance.
          </p>
        </div>
        <a href="/tools/route-planner" class="btn-primary shrink-0 gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
          Start Route Planner
        </a>
      </div>
    </div>

    <!-- Guides Grid -->
    {guides.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 reveal-stagger">
        {guides.map((guide) => (
          <a
            href={`${href}/${guide.slug}`}
            class="brutal-card block overflow-hidden border-t-[3px] border-t-[var(--color-action)] reveal"
          >
            <div class="p-5">
              {guide.draft && (
                <div class="mb-3">
                  <span class="inline-block rounded-[var(--radius-sm)] border border-dashed border-[var(--color-route-incomplete)] bg-[var(--color-surface-container)] px-2 py-0.5 font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-route-incomplete)]">
                    Draft
                  </span>
                </div>
              )}
              <h2 class="text-base font-bold leading-snug text-[var(--color-text-primary)]">
                {guide.title}
              </h2>
              <p class="mt-2 line-clamp-2 text-base text-[var(--color-text-secondary)]">
                {guide.description}
              </p>
              <div class="mt-4 flex items-center justify-between">
                <time
                  datetime={guide.pubDate.toISOString()}
                  class="font-mono text-[11px] text-[var(--color-muted)]">
                  {guide.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span class="flex items-center gap-1 text-sm font-semibold text-[var(--color-action)]">
                  Read
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3">
                    <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="brutal-card p-12 text-center reveal">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-surface-dim)] text-[var(--color-action)] mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-6">
            <path d="M12 6v6l4 2"/>
            <circle cx="12" cy="12" r="10"/>
          </svg>
        </div>
        <p class="text-lg font-medium text-[var(--color-text-primary)]">Coming soon</p>
        <p class="mt-1 text-base text-[var(--color-text-secondary)]">We're working on research-driven guides for this section.</p>
      </div>
    )}

    <!-- Extra slot for pillar-specific content -->
    <slot />
  </section>
</BaseLayout>
