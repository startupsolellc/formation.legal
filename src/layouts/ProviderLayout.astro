---
/**
 * ProviderLayout.astro — Layout for provider review pages.
 * Decision-oriented: who it's for, who it's not for, pricing, affiliate CTA.
 */

import BaseLayout from './BaseLayout.astro';
import { buildArticleSchema, buildBreadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  providerName: string;
  slug: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  bestFor: string[];
  notFor: string[];
  pricing: { year1: number; year2: number; year3: number; renewal?: number; notes?: string };
  affiliateUrl?: string;
  tested: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  providerName,
  slug,
  pubDate,
  updatedDate,
  author = 'Formation.Legal Editorial',
  bestFor,
  notFor,
  pricing,
  affiliateUrl,
  tested,
  noindex = false,
} = Astro.props;

const articleSchema = buildArticleSchema({
  title,
  description,
  pubDate,
  updatedDate,
  author,
  slug,
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Providers', href: '/providers' },
  { name: providerName, href: `/providers/${slug}` },
]);

const dateFormatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const totalCost3yr = pricing.year1 + pricing.year2 + pricing.year3;
---

<BaseLayout
  title={title}
  description={description}
  schemas={[articleSchema, breadcrumbSchema]}
  noindex={noindex}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <!-- Breadcrumb -->
    <nav class="mb-8 text-sm text-[var(--color-muted)]" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-primary-900)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/providers" class="hover:text-[var(--color-primary-900)] transition-colors">Providers</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-primary-900)] font-medium line-clamp-1">{providerName}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2 text-xs">
        <span class="rounded-full bg-[var(--color-primary-50)] px-2.5 py-0.5 font-medium text-[var(--color-primary-700)]">
          Provider Review
        </span>
        {tested && (
          <span class="rounded-full bg-[oklch(0.95_0.05_155)] px-2.5 py-0.5 font-medium text-[oklch(0.35_0.12_155)]">
            ✓ Tested
          </span>
        )}
      </div>

      <h1 class="text-3xl font-bold text-[var(--color-primary-950)] sm:text-4xl">
        {title}
      </h1>
      <p class="mt-4 text-lg text-[var(--color-muted)]">{description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-[var(--color-muted)]">
        <span>{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
      </div>
    </header>

    <!-- Quick Decision Box -->
    <div class="mb-10 grid gap-4 sm:grid-cols-2">
      <!-- Best For -->
      <div class="rounded-lg border border-[oklch(0.85_0.08_155)] bg-[oklch(0.97_0.02_155)] p-4">
        <h3 class="text-sm font-semibold text-[oklch(0.35_0.12_155)]">✓ Best for</h3>
        <ul class="mt-2 space-y-1 text-sm text-[var(--color-primary-800)]">
          {bestFor.map((item) => <li>• {item}</li>)}
        </ul>
      </div>
      <!-- Not For -->
      <div class="rounded-lg border border-[oklch(0.85_0.08_25)] bg-[oklch(0.97_0.02_25)] p-4">
        <h3 class="text-sm font-semibold text-[oklch(0.40_0.15_25)]">✗ Not ideal for</h3>
        <ul class="mt-2 space-y-1 text-sm text-[var(--color-primary-800)]">
          {notFor.map((item) => <li>• {item}</li>)}
        </ul>
      </div>
    </div>

    <!-- Pricing Table -->
    <div class="mb-10 overflow-hidden rounded-lg border border-[var(--color-border)]">
      <table class="w-full text-sm">
        <thead class="bg-[var(--color-surface-alt)]">
          <tr>
            <th class="px-4 py-3 text-left font-medium text-[var(--color-muted)]">Period</th>
            <th class="px-4 py-3 text-right font-medium text-[var(--color-muted)]">Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--color-border)]">
          <tr><td class="px-4 py-3">Year 1</td><td class="px-4 py-3 text-right font-semibold">${pricing.year1}</td></tr>
          <tr><td class="px-4 py-3">Year 2</td><td class="px-4 py-3 text-right font-semibold">${pricing.year2}</td></tr>
          <tr><td class="px-4 py-3">Year 3</td><td class="px-4 py-3 text-right font-semibold">${pricing.year3}</td></tr>
          <tr class="bg-[var(--color-surface-alt)] font-bold">
            <td class="px-4 py-3">3-Year Total</td>
            <td class="px-4 py-3 text-right">${totalCost3yr}</td>
          </tr>
        </tbody>
      </table>
      {pricing.notes && (
        <p class="border-t border-[var(--color-border)] px-4 py-2 text-xs text-[var(--color-muted)]">
          {pricing.notes}
        </p>
      )}
    </div>

    <!-- Content -->
    <div class="prose prose-lg">
      <slot />
    </div>

    <!-- Affiliate CTA -->
    {affiliateUrl && (
      <div class="mt-12 rounded-lg border border-[var(--color-accent-400)]/30 bg-[var(--color-primary-50)] p-6 text-center">
        <p class="text-sm text-[var(--color-muted)] mb-3">
          Start with the provider that fits your route.
        </p>
        <a
          href={affiliateUrl}
          target="_blank"
          rel="noopener sponsored"
          class="cta-primary"
        >
          Visit {providerName}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
          </svg>
        </a>
        <p class="mt-3 text-xs text-[var(--color-muted)]">
          Affiliate link — see our <a href="/affiliate-disclosure" class="underline">disclosure policy</a>.
        </p>
      </div>
    )}
  </article>
</BaseLayout>
