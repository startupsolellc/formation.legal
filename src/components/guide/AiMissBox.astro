---
/**
 * AiMissBox.astro — Highlights what AI-generated answers typically get wrong.
 * Supports bullet list via items[] or free-form paragraph via slot.
 */

interface Props {
  items?: string[];
  heading?: string;
}

const { items, heading = 'What AI Answers Often Miss' } = Astro.props;
---

<div class="brutal-card p-5 mb-8 bg-[var(--color-surface-container)] border-l-4 border-l-[var(--color-route-risky)]">
  <h3 class="font-mono text-[10px] font-bold uppercase tracking-wider text-[var(--color-route-risky)] mb-3">
    {heading}
  </h3>

  {items && items.length > 0 ? (
    <ul class="space-y-2 text-sm text-[var(--color-text-secondary)] leading-relaxed">
      {items.map((item) => (
        <li class="flex items-start gap-2">
          <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-[var(--color-route-risky)] flex-shrink-0"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  ) : (
    <div class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
      <slot />
    </div>
  )}
</div>
