---
/**
 * DirectAnswer.astro — Renders the direct, quotable answer near the top of a guide.
 * Intended length: 40–70 words. Should be standalone and clear.
 */

interface Props {
  answer: string;
  label?: string;
}

const { answer, label = 'Direct Answer' } = Astro.props;
---

<div class="relative overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-border)] bg-gradient-to-br from-[var(--color-surface-dim)] to-[var(--color-surface-container)] p-5 mb-8">
  <!-- Left accent -->
  <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-[var(--color-action)] to-[var(--color-primary-400)]"></div>

  <div class="pl-3">
    <div class="flex items-center gap-2 mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-[var(--color-action)]">
        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
      </svg>
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-action)]">
        {label}
      </span>
    </div>
    <p class="text-base leading-relaxed text-[var(--color-text-primary)] font-medium">
      {answer}
    </p>
  </div>
</div>
