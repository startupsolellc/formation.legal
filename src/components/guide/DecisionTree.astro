---
/**
 * DecisionTree.astro — Static decision tree for guide pages.
 * Renders a step-by-step question flow with yes/no branches.
 */

interface Step {
  question: string;
  yes?: string;
  no?: string;
  note?: string;
}

interface Props {
  steps: Step[];
  title?: string;
}

const { steps, title = 'Decision Tree' } = Astro.props;
---

<div class="brutal-card overflow-hidden mb-8">
  <div class="px-5 py-3 border-b border-[var(--color-border)] bg-[var(--color-surface-container)]">
    <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-[var(--color-text-primary)]">
      {title}
    </h2>
  </div>
  <div class="p-5 space-y-4">
    {steps.map((step, i) => (
      <div class="relative pl-8">
        {/* Step number */}
        <div class="absolute left-0 top-0 flex h-6 w-6 items-center justify-center rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface-container)]">
          <span class="font-mono text-xs font-bold text-[var(--color-text-secondary)]">{i + 1}</span>
        </div>

        {/* Connector line */}
        {i < steps.length - 1 && (
          <div class="absolute left-[11px] top-7 bottom-0 w-px bg-[var(--color-border)]" style="min-height: 1rem;"></div>
        )}

        {/* Question */}
        <p class="text-base font-semibold text-[var(--color-text-primary)] mb-2">{step.question}</p>

        {/* Branches */}
        <div class="space-y-1.5">
          {step.yes && (
            <div class="flex items-start gap-2">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-route-safe)] mt-0.5 flex-shrink-0 w-8">Yes →</span>
              <span class="text-base text-[var(--color-text-secondary)]">{step.yes}</span>
            </div>
          )}
          {step.no && (
            <div class="flex items-start gap-2">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-route-blocked)] mt-0.5 flex-shrink-0 w-8">No →</span>
              <span class="text-base text-[var(--color-text-secondary)]">{step.no}</span>
            </div>
          )}
        </div>

        {/* Note */}
        {step.note && (
          <p class="mt-2 text-sm text-[var(--color-text-secondary)] italic border-l-2 border-[var(--color-border)] pl-3">
            {step.note}
          </p>
        )}
      </div>
    ))}
  </div>
</div>
