---
/**
 * ReviewerNote.astro — Short note from the reviewer about context or limitations.
 */

interface Props {
  reviewer: string;
  note: string;
}

const { reviewer, note } = Astro.props;
---

<div class="brutal-card p-4 bg-[var(--color-surface-container)] mt-6">
  <div class="flex items-start gap-3">
    <div class="flex-shrink-0 h-8 w-8 rounded-[var(--radius-full)] bg-white border border-[var(--color-border)] flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-[var(--color-text-secondary)]">
        <path d="M10 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3.465 14.493a1.23 1.23 0 0 0 .41 1.412A9.957 9.957 0 0 0 10 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 0 0-13.074.003Z" />
      </svg>
    </div>
    <div>
      <p class="text-sm font-bold text-[var(--color-text-primary)]">{reviewer}</p>
      <p class="mt-1 text-base text-[var(--color-text-secondary)] leading-relaxed">{note}</p>
    </div>
  </div>
</div>
