---
/**
 * Disclaimer.astro — Critical legal/tax disclaimer component.
 * Can be embedded at the bottom of guides or in the footer.
 */
---

<div class="brutal-card p-4 bg-[var(--color-error-bg)] border-[var(--color-error)] mb-8">
  <div class="flex items-start gap-3">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5 text-[var(--color-error-text)] mt-0.5 flex-shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div>
      <p class="text-sm font-bold text-[var(--color-error-text)] uppercase tracking-wide">Not Legal or Tax Advice</p>
      <p class="mt-1 text-xs text-[var(--color-error-text)] leading-relaxed">
        The content on Formation.Legal is for informational and educational purposes only. We are an independent research platform, not a law firm or CPA. Information may not reflect the most current legal developments. You should always consult with a qualified attorney or tax professional regarding your specific situation before making decisions. <a href="/disclaimer" class="font-bold underline hover:text-[var(--color-error)]">Read our full disclaimer</a>.
      </p>
    </div>
  </div>
</div>
