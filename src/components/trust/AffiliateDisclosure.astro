---
/**
 * AffiliateDisclosure.astro — Inline disclosure for guide and provider pages.
 */
---

<div class="brutal-card p-4 bg-[var(--color-surface-container)] border-[var(--color-border)] mb-8">
  <div class="flex items-start gap-3">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5 text-[var(--color-text-secondary)] mt-0.5 flex-shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
    </svg>
    <div>
      <p class="text-sm font-semibold text-[var(--color-text-primary)]">Transparent Affiliate Disclosure</p>
      <p class="mt-1 text-xs text-[var(--color-text-secondary)] leading-relaxed">
        We may earn a commission if you purchase through our links. However, this does not impact our provider research, methodologies, or the negative aspects we highlight. We recommend routes based on operational reality, not commission rates. <a href="/affiliate-disclosure" class="font-semibold text-[var(--color-action)] hover:underline">Learn how we make money</a>.
      </p>
    </div>
  </div>
</div>
