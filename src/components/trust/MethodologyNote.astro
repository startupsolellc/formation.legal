---
/**
 * MethodologyNote.astro — Explains the research methodology used for a guide.
 */

interface Props {
  methodology?: string;
}

const { methodology = 'This guide is based on primary source analysis, provider testing, and community data points. Our methodology prioritizes operational reality over marketing claims.' } = Astro.props;
---

<div class="brutal-card p-4 mt-6">
  <div class="flex items-center gap-2 mb-3 pb-2 border-b border-[var(--color-border)]">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-[var(--color-text-secondary)]">
      <path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5V7A2.5 2.5 0 0 0 11 4.5H8.128a2.252 2.252 0 0 1 1.884-1.488A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd" />
      <path fill-rule="evenodd" d="M2 7a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7Zm2 3.25a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1-.75-.75Zm0 3.5a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
    </svg>
    <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-primary)]">Methodology</h4>
  </div>
  <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{methodology}</p>
  <a href="/source-methodology" class="inline-block mt-3 text-xs font-semibold text-[var(--color-action)] hover:text-[var(--color-action-hover)]">
    Read our full methodology →
  </a>
</div>
