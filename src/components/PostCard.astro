---
/**
 * PostCard.astro — Blog post preview card for listing pages.
 */

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  author: string;
  humanGenerated: boolean;
  aiAssisted: boolean;
  category: string;
}

const { title, description, pubDate, slug, author, humanGenerated, aiAssisted, category } =
  Astro.props;

const dateFormatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const trustLabel = humanGenerated
  ? aiAssisted
    ? 'AI-assisted'
    : 'Human-written'
  : 'AI-generated';

const trustColor = humanGenerated
  ? 'text-[var(--color-trust)]'
  : 'text-[var(--color-route-risky)]';
---

<article class="brutal-card overflow-hidden">
  <a href={`/blog/${slug}`} class="block">
    <!-- Top accent bar -->
    <div class="h-1 bg-gradient-to-r from-[var(--color-action)] to-[var(--color-primary-400)]"></div>

    <div class="p-5">
      <!-- Category & Trust -->
      <div class="mb-3 flex items-center gap-2 text-sm">
        <span class="rounded-full bg-[var(--color-primary-50)] px-2.5 py-0.5 font-medium text-[var(--color-action)]">
          {category}
        </span>
        <span class="text-[var(--color-border)]">·</span>
        <span class:list={['font-medium', trustColor]}>{trustLabel}</span>
      </div>

      <!-- Title -->
      <h3 class="text-lg font-semibold leading-snug text-[var(--color-text-primary)] group-hover:text-[var(--color-action)] transition-colors">
        {title}
      </h3>

      <!-- Description -->
      <p class="mt-2 line-clamp-2 text-base text-[var(--color-text-secondary)]">
        {description}
      </p>

      <!-- Meta -->
      <div class="mt-4 flex items-center gap-3 text-sm text-[var(--color-muted)] font-mono">
        <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
        <span aria-hidden="true">·</span>
        <span>{author}</span>
      </div>
    </div>
  </a>
</article>
