---
/**
 * Footer.astro — Premium dark footer with trust signals.
 */

import { SITE } from '../lib/constants';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0f111a] text-stone-300">
  <!-- Gradient divider -->
  <div class="section-divider"></div>

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">
      <!-- Brand & Copyright -->
      <div class="flex flex-col gap-3">
        <a href="/" class="flex items-center gap-2 text-white font-bold text-lg tracking-tight" aria-label="Formation.Legal Home">
          <img src="/logo-dark.svg" alt="" class="h-8 w-auto" aria-hidden="true" />
          <span class="sr-only">Formation.Legal</span>
        </a>
        <p class="text-base text-stone-400 max-w-xs">
          Independent research platform for non-US founders navigating US business formation.
        </p>
        <p class="text-sm text-stone-500">
          &copy; {currentYear} {SITE.title}. All rights reserved.
        </p>
      </div>

      <!-- Link Groups -->
      <div class="flex flex-wrap gap-12 text-base">
        <!-- Trust Links -->
        <div class="flex flex-col gap-3">
          <h4 class="text-sm font-bold uppercase tracking-wider text-stone-500">Trust</h4>
          <nav class="flex flex-col gap-2" aria-label="Trust navigation">
            <a href="/editorial-policy" class="text-stone-400 hover:text-white transition-colors">Editorial Policy</a>
            <a href="/affiliate-disclosure" class="text-stone-400 hover:text-white transition-colors">Affiliate Disclosure</a>
            <a href="/disclaimer" class="text-stone-400 hover:text-white transition-colors">Disclaimer</a>
            <a href="/source-methodology" class="text-stone-400 hover:text-white transition-colors">Source Methodology</a>
          </nav>
        </div>

        <!-- Tech Links -->
        <div class="flex flex-col gap-3">
          <h4 class="text-sm font-bold uppercase tracking-wider text-stone-500">Technical</h4>
          <nav class="flex flex-col gap-2" aria-label="Technical navigation">
            <a href="/llms.txt" class="text-stone-400 hover:text-white transition-colors">llms.txt</a>
            <a href="/robots.txt" class="text-stone-400 hover:text-white transition-colors">robots.txt</a>
            <a href="/sitemap-index.xml" class="text-stone-400 hover:text-white transition-colors">Sitemap</a>
          </nav>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 pt-6 border-t border-stone-800 text-sm text-stone-500">
      Not a law firm. Not tax advice. See <a href="/disclaimer" class="underline hover:text-stone-300 transition-colors">Disclaimer</a>.
    </div>
  </div>
</footer>
