---
/**
 * ProviderRouteFitCard.astro — Scenario-based provider card.
 */

interface Props {
  providerName: string;
  routeFitLabel: string;
  mayFit: string[];
  notIdealFor: string[];
  costNotes: string;
  addressSupportNotes: string;
  testingStatus: string;
  pricingStatus: string;
  lastChecked: string;
  ctaHref: string;
  ctaLabel: string;
}

const {
  providerName,
  routeFitLabel,
  mayFit,
  notIdealFor,
  costNotes,
  addressSupportNotes,
  testingStatus,
  pricingStatus,
  lastChecked,
  ctaHref,
  ctaLabel,
} = Astro.props;

const lastCheckedFormatted = new Date(`${lastChecked}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="brutal-card overflow-hidden">
  <div class="border-b border-[var(--color-border)] bg-[var(--color-surface-container)] px-5 py-4">
    <p class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-action)]">
      {routeFitLabel}
    </p>
    <h3 class="mt-1 text-lg font-bold text-[var(--color-text-primary)]">{providerName}</h3>
  </div>
  <div class="space-y-5 p-5">
    <div>
      <h4 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-[var(--color-trust)] mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3.5">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        May fit
      </h4>
      <ul class="space-y-1.5">
        {mayFit.map((item) => (
          <li class="flex items-start gap-2 text-base leading-relaxed text-[var(--color-text-secondary)]">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-[var(--color-trust)] flex-shrink-0"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-[var(--color-route-risky)] mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3.5">
          <path d="M18 6L6 18"/><path d="M6 6l12 12"/>
        </svg>
        Not ideal for
      </h4>
      <ul class="space-y-1.5">
        {notIdealFor.map((item) => (
          <li class="flex items-start gap-2 text-base leading-relaxed text-[var(--color-text-secondary)]">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-[var(--color-route-risky)] flex-shrink-0"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="grid gap-3 border-t border-[var(--color-border)] pt-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-primary)]">Cost notes</p>
        <p class="mt-1 text-base leading-relaxed text-[var(--color-text-secondary)]">{costNotes}</p>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-primary)]">Address / support notes</p>
        <p class="mt-1 text-base leading-relaxed text-[var(--color-text-secondary)]">{addressSupportNotes}</p>
      </div>
    </div>

    <dl class="grid gap-2 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface-container)] p-3 text-sm">
      <div class="flex items-center justify-between gap-3">
        <dt class="font-semibold text-[var(--color-text-primary)]">Research status</dt>
        <dd class="text-right text-[var(--color-muted)]">{testingStatus}</dd>
      </div>
      <div class="flex items-center justify-between gap-3">
        <dt class="font-semibold text-[var(--color-text-primary)]">Pricing status</dt>
        <dd class="text-right text-[var(--color-muted)]">{pricingStatus}</dd>
      </div>
      <div class="flex items-center justify-between gap-3">
        <dt class="font-semibold text-[var(--color-text-primary)]">Last checked</dt>
        <dd class="text-right font-mono text-[var(--color-muted)]">{lastCheckedFormatted}</dd>
      </div>
    </dl>

    <a href={ctaHref} class="btn-secondary w-full gap-2">
      {ctaLabel}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
        <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>
