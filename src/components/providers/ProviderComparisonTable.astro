---
/**
 * ProviderComparisonTable.astro — Route-fit matrix without rankings.
 */

interface RouteFitRow {
  scenario: string;
  betterFit: string;
  why: string;
  caveat: string;
  nextStepLabel: string;
  nextStepHref: string;
}

interface Props {
  rows: RouteFitRow[];
}

const { rows } = Astro.props;
---

<div class="overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white">
  <div class="overflow-x-auto">
    <table class="min-w-[860px] w-full border-collapse text-left">
      <caption class="sr-only">Route-fit matrix for LLC formation providers</caption>
      <thead>
        <tr class="border-b border-[var(--color-border)] bg-[var(--color-surface-container)]">
          <th scope="col" class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-[var(--color-text-primary)]">Founder scenario</th>
          <th scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[var(--color-text-primary)]">Route fit</th>
          <th scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[var(--color-text-primary)]">Why it may fit</th>
          <th scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[var(--color-text-primary)]">Caveat</th>
          <th scope="col" class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[var(--color-text-primary)]">Next step</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--color-border)]">
        {rows.map((row) => (
          <tr class="align-top">
            <th scope="row" class="px-5 py-4 text-sm font-bold text-[var(--color-text-primary)]">
              {row.scenario}
            </th>
            <td class="px-4 py-4 text-sm font-semibold text-[var(--color-text-primary)]">
              {row.betterFit}
            </td>
            <td class="px-4 py-4 text-sm leading-relaxed text-[var(--color-text-secondary)]">
              {row.why}
            </td>
            <td class="px-4 py-4 text-sm leading-relaxed text-[var(--color-text-secondary)]">
              {row.caveat}
            </td>
            <td class="px-4 py-4">
              <a
                href={row.nextStepHref}
                class="inline-flex rounded-[var(--radius-md)] border border-[var(--color-action)] px-3 py-2 text-xs font-semibold text-[var(--color-action)] transition-colors hover:bg-[var(--color-surface-container)]"
              >
                {row.nextStepLabel}
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
