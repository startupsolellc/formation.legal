---
/**
 * Research hub — evidence layer: reports, source logs, datasets.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildBreadcrumbSchema } from '../../lib/schema';

const research = (await getCollection('research'))
  .filter((r) => !r.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Research', href: '/research' },
]);
---
<BaseLayout
  title="Research — Formation.Legal"
  description="Source logs, datasets, methodology, case studies, and independent research for non-US founder decisions."
  schemas={[breadcrumbSchema]}
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <nav class="mb-8 text-sm text-[var(--color-muted)]" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-primary-900)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-primary-900)] font-medium">Research</li>
      </ol>
    </nav>

    <header class="mb-12">
      <h1 class="text-3xl font-bold text-[var(--color-primary-950)] sm:text-4xl">Research & Evidence</h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--color-muted)]">
        Source logs, independent reports, provider test results, and datasets that back our recommendations.
      </p>
    </header>

    {research.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {research.map((item) => (
          <a href={`/research/${item.id}`} class="group rounded-lg border border-[var(--color-border)] bg-white p-5 transition-all hover:border-[var(--color-accent-400)] hover:shadow-md">
            <div class="mb-2 text-xs">
              <span class="rounded-full bg-[var(--color-primary-50)] px-2.5 py-0.5 font-medium text-[var(--color-primary-700)]">{item.data.category}</span>
            </div>
            <h3 class="text-lg font-semibold text-[var(--color-primary-950)] group-hover:text-[var(--color-accent-600)] transition-colors">{item.data.title}</h3>
            <p class="mt-2 line-clamp-2 text-sm text-[var(--color-muted)]">{item.data.description}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-alt)] p-12 text-center">
        <p class="text-lg font-medium text-[var(--color-primary-800)]">Coming soon</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">Independent research and source documentation in progress.</p>
      </div>
    )}
  </section>
</BaseLayout>
