---
/**
 * Blog listing page — All published posts.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { buildBreadcrumbSchema } from '../../lib/schema';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
]);
---

<BaseLayout
  title="Blog — Legal Formation Guides"
  description="Browse our collection of research-driven guides on LLC formation, registered agents, and business compliance."
  schemas={[breadcrumbSchema]}
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <!-- Breadcrumb -->
    <nav class="mb-8 text-sm text-[var(--color-muted)]" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-primary-900)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-primary-900)] font-medium">Blog</li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-[var(--color-primary-950)]">
        Legal Formation Guides
      </h1>
      <p class="mt-2 text-[var(--color-muted)]">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} on LLC formation, compliance, and more.
      </p>
    </div>

    <!-- Posts Grid -->
    {posts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            author={post.data.author}
            humanGenerated={post.data.humanGenerated}
            aiAssisted={post.data.aiAssisted}
            category={post.data.category}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-alt)] p-12 text-center">
        <p class="text-lg font-medium text-[var(--color-primary-800)]">No articles yet</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">Check back soon for new content.</p>
      </div>
    )}
  </section>
</BaseLayout>
