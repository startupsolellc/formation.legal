---
/**
 * Homepage — Formation.Legal
 * Route Engine Hub: Refined Authority Design
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { PILLARS } from '../lib/constants';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides'))
  .filter((g) => !g.data.noindex && !g.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const pillarIcons: Record<string, string> = {
  'payment-access': '<path d="M2 7a2 2 0 012-2h16a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V7z"/><path d="M2 10h20"/><path d="M6 14h2"/><path d="M12 14h6"/>',
  'address-banking': '<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-4a2 2 0 012-2h2a2 2 0 012 2v4"/>',
  'compliance': '<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/>',
  'providers': '<circle cx="9" cy="7" r="3"/><circle cx="15" cy="7" r="3"/><path d="M5 21v-2a4 4 0 014-4h6a4 4 0 014 4v2"/>',
  'playbooks': '<path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M4 4.5A2.5 2.5 0 016.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15z"/><path d="M8 7h8"/><path d="M8 11h6"/>',
};

const pillarColors: Record<string, string> = {
  'payment-access': '#059669',
  'address-banking': '#2563eb',
  'compliance': '#d97706',
  'providers': '#7c3aed',
  'playbooks': '#0891b2',
};
---

<BaseLayout title="Formation.Legal — US Business Route Engine for Non-US Founders">
  <!-- Story-Driven Hero -->
  <section class="hero-gradient border-b border-[var(--color-border-subtle)] relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay pointer-events-none"></div>
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-32 relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <div class="flex-1 text-center lg:text-left">
          <div class="reveal is-visible">
            <p class="inline-flex items-center gap-2 rounded-full bg-[var(--color-surface-dim)] border border-[var(--color-border)] px-4 py-1.5 text-sm font-bold tracking-wide text-[var(--color-text-primary)] mb-6 shadow-sm">
              <span class="flex size-2 rounded-full bg-[var(--color-trust)] animate-pulse"></span>
              Independent · Research-Driven
            </p>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-[1.1] tracking-tight text-[var(--color-text-primary)] reveal is-visible">
            The US LLC Route
            <span class="block bg-gradient-to-r from-[var(--color-action)] to-[#818cf8] bg-clip-text text-transparent mt-1">Engineered for You.</span>
          </h1>
          <p class="mt-6 text-lg md:text-xl leading-relaxed text-[var(--color-text-secondary)] reveal is-visible max-w-2xl mx-auto lg:mx-0">
            Compare payment access, banking risk, and 3-year compliance costs before you spend a dime. Stop following generic blogs; build the route that actually works.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 reveal is-visible justify-center lg:justify-start">
            <a href="/tools/route-planner" class="btn-primary gap-2 w-full sm:w-auto shadow-lg shadow-[var(--color-action)]/20">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                <polygon points="3 11 22 2 13 21 11 13 3 11"/>
              </svg>
              Start Route Planner
            </a>
            <a href="#explore" class="btn-secondary gap-2 w-full sm:w-auto">
              Explore Research
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
                <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Abstract Hero Illustration (3D / Motion vibe via CSS) -->
        <div class="hidden lg:block flex-1 reveal is-visible relative h-[300px] w-full perspective-1000">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-64 h-64 rounded-3xl bg-gradient-to-tr from-[var(--color-action)] to-[#fbbf24] opacity-20 blur-3xl absolute animate-pulse"></div>
            <div class="relative z-10 grid grid-cols-2 gap-4 transform rotate-x-12 rotate-y-[-15deg] hover:rotate-x-0 hover:rotate-y-0 transition-transform duration-700 ease-out">
              <div class="w-32 h-32 rounded-2xl bg-[var(--color-surface-container)] border border-[var(--color-border)] shadow-xl flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--color-action)" stroke-width="1.5" class="size-10"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
              </div>
              <div class="w-32 h-32 rounded-2xl bg-[var(--color-surface-container)] border border-[var(--color-border)] shadow-xl flex items-center justify-center translate-y-8">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--color-route-safe)" stroke-width="1.5" class="size-10"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/></svg>
              </div>
              <div class="w-32 h-32 rounded-2xl bg-[var(--color-surface-container)] border border-[var(--color-border)] shadow-xl flex items-center justify-center -translate-y-8">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--color-route-risky)" stroke-width="1.5" class="size-10"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8"/><path d="M8 10h8"/></svg>
              </div>
              <div class="w-32 h-32 rounded-2xl bg-[var(--color-surface-container)] border border-[var(--color-border)] shadow-xl flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-400)" stroke-width="1.5" class="size-10"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof / Trust Bar -->
  <section class="border-b border-[var(--color-border-subtle)] bg-[var(--color-surface-container)]">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-8 px-4 py-6 sm:gap-16 sm:px-6">
      <div class="flex items-center gap-3 text-sm md:text-base font-semibold text-[var(--color-text-secondary)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5 text-[var(--color-text-muted)]"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        No Affiliate Bias
      </div>
      <div class="flex items-center gap-3 text-sm md:text-base font-semibold text-[var(--color-text-secondary)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5 text-[var(--color-text-muted)]"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Data-Driven Research
      </div>
      <div class="flex items-center gap-3 text-sm md:text-base font-semibold text-[var(--color-text-secondary)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5 text-[var(--color-text-muted)]"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Human Written
      </div>
    </div>
  </section>

  <!-- Bento Grid 2.0: Pillar Hubs -->
  <section id="explore" class="py-20 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center md:text-left reveal">
        <p class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-action)] mb-2">The Architecture</p>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
          Explore by Decision Pillar
        </h2>
        <p class="mt-3 text-lg text-[var(--color-text-secondary)] max-w-2xl">
          Everything you need to know about setting up your US LLC, organized into five critical operational vectors.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-6 gap-6 reveal-stagger">
        {PILLARS.map((pillar, index) => {
          // Bento layout logic: 
          // Payment (0): span 4, Address (1): span 2
          // Compliance (2): span 3, Providers (3): span 3
          // Playbooks (4): span 6
          let spanClass = "md:col-span-6"; // Default
          if (index === 0) spanClass = "md:col-span-4";
          else if (index === 1) spanClass = "md:col-span-2";
          else if (index === 2) spanClass = "md:col-span-3";
          else if (index === 3) spanClass = "md:col-span-3";
          else if (index === 4) spanClass = "md:col-span-6";

          return (
            <a
              href={pillar.href}
              class={`brutal-card group relative block overflow-hidden p-8 reveal ${spanClass}`}
            >
              <!-- Hover Glow Effect -->
              <div class="absolute -inset-px bg-gradient-to-r from-[var(--color-action)] to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-[0.15] pointer-events-none rounded-[var(--radius-xl)]"></div>
              
              <div class="relative z-10 flex flex-col h-full justify-between">
                <div>
                  <div
                    class="flex items-center justify-center w-12 h-12 rounded-xl mb-6 shadow-sm border border-[var(--color-border-subtle)] bg-[var(--color-surface)]"
                    style={`color: ${pillarColors[pillar.id] || 'var(--color-action)'}`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6" set:html={pillarIcons[pillar.id] || ''} />
                  </div>
                  <h3 class="text-2xl font-bold text-[var(--color-text-primary)] mb-3 group-hover:text-[var(--color-action)] transition-colors">{pillar.shortLabel}</h3>
                  <p class="text-[var(--color-text-secondary)] leading-relaxed">{pillar.description}</p>
                </div>
                
                <div class="mt-8 flex items-center font-bold text-sm text-[var(--color-text-primary)] group-hover:text-[var(--color-action)] transition-colors">
                  Read Guides
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="ml-2 size-4 transition-transform group-hover:translate-x-1">
                    <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured Guides -->
  {guides.length > 0 && (
    <section class="bg-white">
      <div class="section-divider"></div>
      <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
        <div class="mb-8 flex items-end justify-between reveal">
          <div>
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-muted)] mb-1">Latest research</p>
            <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">
              Latest Guides
            </h2>
          </div>
          <a
            href="/research"
            class="flex items-center gap-1 text-base font-semibold text-[var(--color-action)] hover:text-[var(--color-action-hover)] transition-colors"
          >
            View all
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
              <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 reveal-stagger">
          {guides.map((guide) => {
             const p = PILLARS.find(x => x.id === guide.data.pillar);
             const borderColor = pillarColors[guide.data.pillar] || 'var(--color-action)';
             return (
              <a
                href={`${p?.href}/${guide.id}`}
                class="brutal-card block overflow-hidden reveal"
                style={`border-top: 3px solid ${borderColor}`}
              >
                <div class="px-4 py-3 bg-[var(--color-surface-container)]">
                  <span
                    class="text-xs font-bold uppercase tracking-wider"
                    style={`color: ${borderColor}`}
                  >
                    {p?.shortLabel}
                  </span>
                </div>
                <div class="p-4">
                  <h3 class="text-base font-bold leading-snug text-[var(--color-text-primary)]">
                    {guide.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-base text-[var(--color-text-secondary)]">
                    {guide.data.description}
                  </p>
                  <div class="mt-4 text-xs font-medium text-[var(--color-muted)] font-mono">
                    {guide.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
