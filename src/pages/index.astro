---
/**
 * Homepage — Formation.Legal
 * Route Engine Hub: Institutional Clarity Design
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { PILLARS } from '../lib/constants';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides'))
  .filter((g) => !g.data.noindex && !g.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Formation.Legal — US Business Route Engine for Non-US Founders">
  <!-- Manifesto Hero -->
  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-28 text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] max-w-4xl mx-auto">
        Don't form a US LLC because a blog told you to.
        <span class="block text-[var(--color-action)] mt-2">Build the route that actually works.</span>
      </h1>
      <p class="mt-8 mx-auto max-w-2xl text-lg leading-relaxed text-[var(--color-text-secondary)]">
        Formation.Legal helps non-US founders compare payment access, banking risk, address requirements, annual compliance, 3-year costs, and formation providers before they spend money.
      </p>
      <div class="mt-10 flex justify-center gap-4">
        <a
          href="/tools/route-planner"
          class="inline-flex items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-action)] border border-[var(--color-action)] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-action-hover)]"
        >
          Start Route Planner
        </a>
        <a
          href="/research"
          class="inline-flex items-center justify-center rounded-[var(--radius-md)] bg-white border border-[var(--color-action)] px-6 py-3 text-sm font-semibold text-[var(--color-action)] transition-colors hover:bg-[var(--color-surface-container)]"
        >
          View Research
        </a>
      </div>
    </div>
  </section>

  <!-- Problem Grid -->
  <section class="border-b border-[var(--color-border)] bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <div class="grid gap-8 md:grid-cols-3">
        <div class="brutal-card p-6">
          <div class="mb-4 border-b border-[var(--color-border)] pb-4">
            <h3 class="text-lg font-bold text-[var(--color-text-primary)]">High Banking Risk</h3>
          </div>
          <p class="text-sm text-[var(--color-text-secondary)]">
            Opening a US bank account without a physical presence has become increasingly difficult. We analyze account closure risks and approval rates.
          </p>
        </div>
        <div class="brutal-card p-6">
          <div class="mb-4 border-b border-[var(--color-border)] pb-4">
            <h3 class="text-lg font-bold text-[var(--color-text-primary)]">Hidden Compliance Costs</h3>
          </div>
          <p class="text-sm text-[var(--color-text-secondary)]">
            State franchise taxes and registered agent fees can trap you. We calculate the true <span class="data-mono">3-year</span> cost of ownership.
          </p>
        </div>
        <div class="brutal-card p-6">
          <div class="mb-4 border-b border-[var(--color-border)] pb-4">
            <h3 class="text-lg font-bold text-[var(--color-text-primary)]">Stripe & PayPal Limits</h3>
          </div>
          <p class="text-sm text-[var(--color-text-secondary)]">
            LLC formation does not guarantee payment processor access. We map out exactly which routes successfully unlock Stripe.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface-container)]">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-6 px-4 py-4 text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] sm:gap-10 sm:px-6">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[var(--color-route-safe)]"></span>
        <span>Independent Research</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[var(--color-route-safe)]"></span>
        <span>No Affiliate Bias</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[var(--color-route-safe)]"></span>
        <span>Human Written</span>
      </div>
    </div>
  </section>

  <!-- Pillar Hubs -->
  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <div class="mb-10 text-center">
        <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">
          Choose your route
        </h2>
        <p class="mt-2 text-[var(--color-text-secondary)]">
          Explore our research pillars tailored to specific operational hurdles.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {PILLARS.map((pillar) => (
          <a href={pillar.href} class="brutal-card block transition-colors hover:border-[var(--color-action)]">
            <div class="border-b border-[var(--color-border)] p-5">
              <h3 class="text-lg font-bold text-[var(--color-text-primary)]">{pillar.shortLabel}</h3>
            </div>
            <div class="p-5">
              <p class="text-sm text-[var(--color-text-secondary)]">{pillar.description}</p>
              <div class="mt-4 text-xs font-semibold text-[var(--color-action)] uppercase tracking-wider">
                Explore Pillar →
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Guides -->
  {guides.length > 0 && (
    <section class="bg-white">
      <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
        <div class="mb-8 flex items-end justify-between border-b border-[var(--color-border)] pb-4">
          <div>
            <h2 class="text-2xl font-bold text-[var(--color-text-primary)]">
              Latest Guides
            </h2>
          </div>
          <a
            href="/research"
            class="text-sm font-semibold text-[var(--color-action)] hover:text-[var(--color-action-hover)] transition-colors"
          >
            View all →
          </a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {guides.map((guide) => {
             const p = PILLARS.find(x => x.id === guide.data.pillar);
             return (
              <a href={`${p?.href}/${guide.id}`} class="brutal-card block transition-colors hover:border-[var(--color-action)]">
                <div class="border-b border-[var(--color-border)] px-4 py-3 bg-[var(--color-surface-container)]">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-secondary)]">{p?.shortLabel}</span>
                </div>
                <div class="p-4">
                  <h3 class="text-base font-bold leading-snug text-[var(--color-text-primary)]">
                    {guide.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm text-[var(--color-text-secondary)]">
                    {guide.data.description}
                  </p>
                  <div class="mt-4 text-[10px] font-medium text-[var(--color-text-secondary)] uppercase">
                    {guide.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
