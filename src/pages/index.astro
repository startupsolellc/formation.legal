---
/**
 * Homepage — Formation.Legal
 * Hero section + latest blog posts grid.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout title="Formation.Legal — Trusted Legal Formation Guides">
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[var(--color-primary-950)] to-[var(--color-primary-800)] text-white">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-28">
      <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Unbiased Legal Formation
        <span class="block text-[var(--color-accent-400)]">Research & Guides</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80">
        Independent, research-driven guides for LLC formation, registered agents,
        and business compliance. No affiliate bias — just the facts you need.
      </p>
      <div class="mt-8 flex gap-4">
        <a
          href="/blog"
          class="inline-flex items-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-[var(--color-primary-900)] shadow-sm transition-all hover:bg-white/90 hover:shadow-md"
        >
          Browse Guides
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1.5 size-4">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Signals Bar -->
  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface-alt)]">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-6 px-4 py-4 text-xs font-medium text-[var(--color-muted)] sm:gap-10 sm:px-6">
      <div class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-[var(--color-trust)]">
          <path fill-rule="evenodd" d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
        </svg>
        <span>Human-written content</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-[var(--color-trust)]">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" />
        </svg>
        <span>No affiliate bias</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-[var(--color-trust)]">
          <path d="M10 1a6 6 0 0 0-3.815 10.631C7.237 12.5 8 13.443 8 14.456v.644a.75.75 0 0 0 .75.75h2.5a.75.75 0 0 0 .75-.75v-.644c0-1.013.762-1.957 1.815-2.825A6 6 0 0 0 10 1ZM8.863 17.414a.75.75 0 0 0-.226 1.483 9.066 9.066 0 0 0 2.726 0 .75.75 0 0 0-.226-1.483 7.563 7.563 0 0 1-2.274 0Z" />
        </svg>
        <span>AI-friendly (llms.txt)</span>
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="mb-8 flex items-end justify-between">
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-primary-950)]">
          Latest Guides
        </h2>
        <p class="mt-1 text-sm text-[var(--color-muted)]">
          Research-driven articles on legal formation topics
        </p>
      </div>
      <a
        href="/blog"
        class="text-sm font-medium text-[var(--color-accent-600)] hover:text-[var(--color-accent-500)] transition-colors"
      >
        View all →
      </a>
    </div>

    {posts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            author={post.data.author}
            humanGenerated={post.data.humanGenerated}
            aiAssisted={post.data.aiAssisted}
            category={post.data.category}
          />
        ))}
      </div>
    ) : (
      <p class="text-center text-[var(--color-muted)]">
        No posts yet. Check back soon!
      </p>
    )}
  </section>
</BaseLayout>
