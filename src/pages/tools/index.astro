---
/**
 * Tools hub — interactive tools listing with status indicators.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildBreadcrumbSchema } from '../../lib/schema';
import { TOOL_ITEMS } from '../../lib/constants';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools' },
]);

const tools = TOOL_ITEMS;

const toolIcons: Record<string, string> = {
  '/tools/route-planner': '<polygon points="3 11 22 2 13 21 11 13 3 11"/>',
  '/tools/cost-calculator': '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8"/><path d="M8 10h8"/><path d="M8 14h4"/>',
  '/costs/annual-report-fees-by-state': '<path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 3v18"/>',
};
---
<BaseLayout
  title="Tools — Formation.Legal"
  description="Interactive tools for non-US founders: route planner, cost calculator, compliance calendar, and more."
  schemas={[breadcrumbSchema]}
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <nav class="mb-8 text-base text-[var(--color-muted)]" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-text-primary)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-text-primary)] font-medium">Tools</li>
      </ol>
    </nav>

    <header class="mb-12 reveal">
      <p class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-muted)] mb-2">Interactive tools</p>
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)] sm:text-4xl">Route Engine Tools</h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--color-text-secondary)]">
        Personalized tools that AI answers can't replace — your country, your business model, your route.
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 reveal-stagger">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="brutal-card block overflow-hidden border-t-[3px] border-t-[var(--color-action)] reveal"
        >
          <div class="p-6">
            <div class="mb-4 flex items-center gap-3">
              <div class="flex items-center justify-center w-10 h-10 rounded-[var(--radius-md)] bg-[var(--color-surface-dim)] text-[var(--color-action)]">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" set:html={toolIcons[tool.href] || ''} />
              </div>
              <div class="flex items-center gap-2">
                <h2 class="text-lg font-semibold text-[var(--color-text-primary)]">{tool.title}</h2>
                {tool.status === 'available' && (
                  <span class="flex items-center gap-1 rounded-full bg-[var(--color-surface-dim)] px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-[var(--color-trust)]">
                    <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-trust)]"></span>
                    Live
                  </span>
                )}
                {tool.status === 'coming-soon' && (
                  <span class="rounded-full bg-[var(--color-surface-dim)] px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-[var(--color-route-incomplete)]">
                    Coming Soon
                  </span>
                )}
              </div>
            </div>
            <p class="text-base leading-relaxed text-[var(--color-text-secondary)]">{tool.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-semibold text-[var(--color-action)]">
              Open tool
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5">
                <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
