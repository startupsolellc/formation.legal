---
/**
 * Cost Calculator — Interactive tool page.
 * Preact island on a static Astro page. No backend.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CostCalculator from '../../components/tools/CostCalculator';
import ToolNav from '../../components/tools/ToolNav.astro';
import { buildBreadcrumbSchema } from '../../lib/schema';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools' },
  { name: '3-Year LLC Cost Calculator', href: '/tools/cost-calculator' },
]);
---

<BaseLayout
  title="3-Year LLC Cost Calculator — Formation.Legal"
  description="Compare LLC formation providers by initial setup cost, first tax season, registered agent renewals, EIN handling, state filing, compliance, and tax-prep assumptions."
  schemas={[breadcrumbSchema]}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav class="mb-8 text-sm text-[var(--color-text-secondary)]" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-text-primary)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/tools" class="hover:text-[var(--color-text-primary)] transition-colors">Tools</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-text-primary)] font-medium">Cost Calculator</li>
      </ol>
    </nav>

    <ToolNav />

    <header class="mb-10 max-w-3xl">
      <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-secondary)]">
        LLC provider costs
      </p>
      <h1 class="mt-3 text-3xl font-bold text-[var(--color-text-primary)] sm:text-4xl">
        3-Year LLC Cost Calculator
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-[var(--color-text-secondary)]">
        Compare provider entry packages by initial setup cost, first tax season, registered agent renewals, state fees, compliance, and tax prep.
      </p>
    </header>

    <div class="brutal-card mb-10 bg-[var(--color-surface-container)] p-4">
      <div class="flex items-start gap-3">
        <svg class="w-4 h-4 text-amber-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
        <div>
          <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-secondary)] mb-1">
            Important
          </p>
          <p class="text-xs leading-relaxed text-[var(--color-text-secondary)]">
            This is an educational estimate, not legal, tax, accounting, or formation advice. Provider pricing and package contents can change. Verify current pricing with each provider before you buy.
          </p>
        </div>
      </div>
    </div>

    <CostCalculator client:load />
  </section>
</BaseLayout>
