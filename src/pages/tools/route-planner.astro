---
/**
 * Route Planner — Interactive tool page.
 * Preact island on a static Astro page. No backend.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RoutePlanner from '../../components/tools/RoutePlanner';
import ToolNav from '../../components/tools/ToolNav.astro';
import { buildBreadcrumbSchema } from '../../lib/schema';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools' },
  { name: 'US Business Route Planner', href: '/tools/route-planner' },
]);
---

<BaseLayout
  title="US Business Route Planner — Formation.Legal"
  description="Get a directional route estimate based on your country, business model, payment goal, address proof, payout path, and compliance needs."
  schemas={[breadcrumbSchema]}
>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <nav class="mb-8 text-sm text-[var(--color-text-secondary)]" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-text-primary)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/tools" class="hover:text-[var(--color-text-primary)] transition-colors">Tools</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-text-primary)] font-medium">Route Planner</li>
      </ol>
    </nav>

    <ToolNav />

    <!-- Header -->
    <div class="mb-10 text-center">
      <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-secondary)]">
        Interactive tool
      </p>
      <h1 class="mt-3 text-3xl font-bold text-[var(--color-text-primary)] sm:text-4xl">
        US Business Route Planner
      </h1>
      <p class="mt-4 text-lg text-[var(--color-text-secondary)] max-w-xl mx-auto leading-relaxed">
        Get a directional route estimate based on your country, business model, payment goal, address proof, payout path, and compliance needs.
      </p>
    </div>

    <!-- Disclaimer -->
    <div class="brutal-card p-4 bg-[var(--color-surface-container)] mb-10">
      <div class="flex items-start gap-3">
        <svg class="w-4 h-4 text-amber-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
        <div>
          <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-secondary)] mb-1">
            Disclaimer
          </p>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            This tool provides a directional route estimate. It is not legal, tax, banking, payment processor, or formation advice. Requirements, provider pricing, and eligibility can change. Verify current requirements with official sources.
          </p>
        </div>
      </div>
    </div>

    <!-- Preact Island -->
    <RoutePlanner client:load />
  </section>
</BaseLayout>
