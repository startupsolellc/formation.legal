---
/**
 * Guides hub — step-by-step tutorials and visual walkthroughs.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildBreadcrumbSchema } from '../../lib/schema';

// We fetch from the 'guides' collection where the pillar is 'guides'
const guidesList = (await getCollection('guides'))
  .filter((g) => !g.data.draft && g.data.pillar === 'guides')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/guides' },
]);
---
<BaseLayout
  title="Step-by-Step LLC Guides & Tutorials — Formation.Legal"
  description="Visual, step-by-step walkthroughs for non-US founders. Learn how to form your US LLC, apply for an EIN, and open bank accounts without expensive middlemen."
  schemas={[breadcrumbSchema]}
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <nav class="mb-8 text-base text-[var(--color-muted)]" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-text-primary)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-text-primary)] font-medium">Guides</li>
      </ol>
    </nav>

    <header class="mb-12 reveal">
      <p class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--color-muted)] mb-2">Tutorials & Walkthroughs</p>
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)] sm:text-4xl">Formation Guides</h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--color-text-secondary)]">
        Skip the middlemen. Our step-by-step, visual tutorials show you exactly how to navigate US bureaucracy, set up your LLC, and open financial accounts yourself.
      </p>
    </header>

    {guidesList.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-2 reveal-stagger">
        {guidesList.map((item) => (
          <a
            href={`/guides/${item.id}`}
            class="brutal-card block overflow-hidden border-t-[3px] border-t-[var(--color-action)] reveal"
          >
            <div class="p-5">
              <div class="mb-3 text-sm flex gap-2">
                <span class="rounded-full bg-[var(--color-surface-dim)] px-2.5 py-0.5 font-medium text-[var(--color-action)]">Guide</span>
                {item.data.tags?.slice(0, 1).map((tag: string) => (
                  <span class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 font-medium text-[var(--color-text-secondary)]">{tag}</span>
                ))}
              </div>
              <h2 class="text-xl font-bold leading-snug text-[var(--color-text-primary)]">{item.data.title}</h2>
              <p class="mt-3 line-clamp-2 text-base text-[var(--color-text-secondary)]">{item.data.description}</p>
              <div class="mt-5 flex items-center justify-between">
                <time datetime={item.data.pubDate.toISOString()} class="font-mono text-[11px] text-[var(--color-muted)]">
                  {item.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span class="flex items-center gap-1 text-sm font-semibold text-[var(--color-action)]">
                  Start Guide
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3">
                    <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="brutal-card p-12 text-center reveal">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-surface-dim)] text-[var(--color-action)] mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-6">
            <path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/>
          </svg>
        </div>
        <p class="text-lg font-medium text-[var(--color-text-primary)]">Coming soon</p>
        <p class="mt-1 text-base text-[var(--color-text-secondary)]">Detailed step-by-step guides are currently in development.</p>
      </div>
    )}
  </section>
</BaseLayout>
