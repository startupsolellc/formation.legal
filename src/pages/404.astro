---
/**
 * 404 — Page Not Found
 * Custom error page for missing routes
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | Formation.Legal"
  description="The page you're looking for doesn't exist. Use the navigation to find what you need."
  noindex={true}
  nofollow={true}
>
  <div class="mx-auto max-w-3xl px-4 py-24 sm:px-6 min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <!-- 404 Display -->
      <div class="mb-8">
        <span class="text-[8rem] sm:text-[10rem] font-extrabold leading-none text-[var(--color-border)] select-none" aria-hidden="true">
          404
        </span>
      </div>

      <!-- Error Message -->
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-primary)] mb-4">
          Page Not Found
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] max-w-md mx-auto">
          The page you're looking for has moved, been deleted, or never existed.
          Use the options below to find what you need.
        </p>
      </div>

      <!-- Navigation Options -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a href="/" class="btn-primary gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Go Home
        </a>
        <a href="/tools/route-planner" class="btn-secondary gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          Use Route Planner
        </a>
      </div>

      <!-- Quick Links -->
      <div class="border-t border-[var(--color-border-subtle)] pt-8">
        <p class="text-sm font-semibold text-[var(--color-text-muted)] mb-4 uppercase tracking-wider">
          Explore Instead
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
          <a href="/research" class="text-[var(--color-text-secondary)] hover:text-[var(--color-action)] transition-colors">
            Research
          </a>
          <a href="/payment-access" class="text-[var(--color-text-secondary)] hover:text-[var(--color-action)] transition-colors">
            Payment Access
          </a>
          <a href="/address-banking" class="text-[var(--color-text-secondary)] hover:text-[var(--color-action)] transition-colors">
            Banking
          </a>
          <a href="/compliance" class="text-[var(--color-text-secondary)] hover:text-[var(--color-action)] transition-colors">
            Compliance
          </a>
          <a href="/providers" class="text-[var(--color-text-secondary)] hover:text-[var(--color-action)] transition-colors">
            Providers
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
