---
/**
 * Providers hub — lists all provider reviews.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildBreadcrumbSchema } from '../../lib/schema';

const providers = (await getCollection('providers'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Providers', href: '/providers' },
]);
---
<BaseLayout
  title="Provider Decision Lab — Formation.Legal"
  description="Route-based provider comparisons for non-US founders. Not which pays the highest commission — which fits your route."
  schemas={[breadcrumbSchema]}
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <nav class="mb-8 text-sm text-[var(--color-muted)]" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-[var(--color-primary-900)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[var(--color-primary-900)] font-medium">Providers</li>
      </ol>
    </nav>

    <header class="mb-12">
      <h1 class="text-3xl font-bold text-[var(--color-primary-950)] sm:text-4xl">Provider Decision Lab</h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--color-muted)]">
        Which provider fits your route — not which pays the highest commission.
      </p>
    </header>

    {providers.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {providers.map((provider) => (
          <a href={`/providers/${provider.id}`} class="group rounded-lg border border-[var(--color-border)] bg-white p-5 transition-all hover:border-[var(--color-accent-400)] hover:shadow-md">
            <div class="mb-2 flex items-center gap-2 text-xs">
              <span class="rounded-full bg-[var(--color-primary-50)] px-2.5 py-0.5 font-medium text-[var(--color-primary-700)]">Provider Review</span>
              {provider.data.tested && <span class="text-[var(--color-trust)] font-medium">✓ Tested</span>}
            </div>
            <h3 class="text-lg font-semibold text-[var(--color-primary-950)] group-hover:text-[var(--color-accent-600)] transition-colors">{provider.data.providerName}</h3>
            <p class="mt-2 line-clamp-2 text-sm text-[var(--color-muted)]">{provider.data.description}</p>
            <p class="mt-3 text-sm font-medium text-[var(--color-primary-800)]">From ${provider.data.pricing.year1}/yr</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-alt)] p-12 text-center">
        <p class="text-lg font-medium text-[var(--color-primary-800)]">Coming soon</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">We're testing and reviewing providers for non-US founders.</p>
      </div>
    )}
  </section>
</BaseLayout>
