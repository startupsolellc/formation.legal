---
/**
 * Payment Access hub page — Pillar 1
 * Lists all guides under payment-access pillar.
 */

import PillarLayout from '../../layouts/PillarLayout.astro';
import { getCollection } from 'astro:content';
import { PILLARS } from '../../lib/constants';

const pillar = PILLARS.find((p) => p.id === 'payment-access')!;

const guides = (await getCollection('guides'))
  .filter((g) => g.data.pillar === 'payment-access')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((g) => ({
    title: g.data.title,
    description: g.data.description,
    slug: g.id,
    pubDate: g.data.pubDate,
    draft: g.data.draft ?? false,
  }));
---

<PillarLayout
  pillarLabel={pillar.label}
  pillarDescription={pillar.description}
  seoTitle="Payment Access for Non-US Founders: Stripe, PayPal"
  seoDescription="Does a US company actually unlock Stripe, PayPal, and global payments? Learn the real requirements for your country and business model."
  mainQuestion={pillar.mainQuestion}
  href={pillar.href}
  guides={guides}
/>
